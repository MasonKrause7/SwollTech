{
  "expo": {
    "name": "SwollTech",
    "slug": "swolltech",
    "scheme": "swolltech",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#0F1011",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#F2C230"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "SwollTech uses the camera so you can film a set and check your form.",
          "microphonePermission": "SwollTech records audio with set videos.",
          "photosPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1011",
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0F1011",
            "image": "./assets/images/icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.swolltech.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SwollTech uses the camera so you can film a set and check your form.",
        "NSMicrophoneUsageDescription": "SwollTech records audio with set videos.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.swolltech.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0F1011"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0107cdd3-5d7c-4dc5-83a1-45789356c1ab"
      }
    },
    "owner": "masonkrause"
  }
}
