# API
# Supabase Dashboard → Project Settings → Database → Connection string → URI.
# Use the direct host on port 5432 and the postgresql+asyncpg scheme.
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.qspstvejkkdpqfwwvtkh.supabase.co:5432/postgres
SUPABASE_URL=https://qspstvejkkdpqfwwvtkh.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=https://qspstvejkkdpqfwwvtkh.supabase.co/auth/v1/.well-known/jwks.json
SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:5173
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
SENTRY_DSN=
# Local only. Lets the web and phone apps sign in without Supabase. Never true in production.
DEV_TOKEN_ENABLED=false

# Tests. The suite drops and rebuilds this database, so it must be a throwaway local one.
# `npm run db:up` starts one on port 54329. Tests refuse to run against Supabase.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54329/swolltech_test

# Web
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://qspstvejkkdpqfwwvtkh.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_DEV_LOGIN=false

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=https://qspstvejkkdpqfwwvtkh.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_DEV_LOGIN=false
