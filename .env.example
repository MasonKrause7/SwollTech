# API (apps/api/.env). On Vercel these come from the project's environment variables;
# the Neon Marketplace integration sets DATABASE_URL, DATABASE_URL_UNPOOLED and NEON_AUTH_BASE_URL.
# Neon pooled connection string (…-pooler…). Any postgres:// form works.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54329/swolltech_dev
# Direct (unpooled) connection, used only by `python -m scripts.migrate`.
DATABASE_URL_UNPOOLED=
# Neon Auth URL, e.g. https://ep-xxx.neonauth.c-5.us-west-2.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=
# Only for a private CA. Neon's certificates are verified with the system store.
DATABASE_SSL_ROOT_CERT=
CORS_ORIGINS=http://localhost:5173
# Optional: also allow origins matching this regex (e.g. the web app's Vercel previews).
CORS_ORIGIN_REGEX=
# Upstash Redis (Vercel Marketplace) for rate limits across function instances.
KV_REST_API_URL=
KV_REST_API_TOKEN=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
SENTRY_DSN=
# Local only. Lets the web and phone apps sign in without Neon Auth against a LOCAL
# database. Refused on Vercel. DEV_JWT_SECRET signs those dev tokens (any 32+ chars).
DEV_TOKEN_ENABLED=false
DEV_JWT_SECRET=

# Tests. The suite drops and rebuilds this database, so it must be a throwaway local one.
# `npm run db:up` starts one on port 54329. Tests refuse to run against a hosted database.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54329/swolltech_test

# Web (apps/web/.env)
VITE_API_URL=http://localhost:8000
# Same value as NEON_AUTH_BASE_URL. The Neon integration also sets VITE_NEON_AUTH_URL.
VITE_NEON_AUTH_URL=
VITE_DEV_LOGIN=false

# Mobile (apps/mobile/.env, or eas.json for builds)
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_NEON_AUTH_URL=
EXPO_PUBLIC_DEV_LOGIN=false
